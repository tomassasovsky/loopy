#!/bin/sh
# segno-bt-ctl — privileged Bluetooth helper the Flutter app drives.
#
# Verbs (stdout = compact JSON; detail on stderr):
#   status                         {supported,powered,discoverable,advertising,alias,
#                                   connected,device}
#   scan                           [{name,address,paired,connected,inRange,icon}, ...]
#   power on|off                   {}  (Control Center tap toggle)
#   discoverable on|off            {}
#   advertise on|off               {}  (power + LE advertise / discoverable)
#   pair ADDRESS                   {}  (discover, pair, trust, connect)
#   connect ADDRESS                {}
#   disconnect ADDRESS             {}  (link down, pairing kept)
#   forget ADDRESS                 {}  (disconnect, untrust, remove)
#
# Every device verb reports only success or failure. The caller re-reads `scan`
# and `status` afterwards rather than trusting the verb's account of what it
# changed, because bluez accepts a command and then leaves the device as it
# was often enough that the verb's exit code is not evidence of state.
set -eu

ALIAS="${SEGNO_BT_ALIAS:-Segno}"
SCAN_SECONDS="${SEGNO_BT_SCAN_SECONDS:-5}"
STATUS_UNSUPPORTED='{"supported":false,"powered":false,"discoverable":false,"advertising":false,"alias":"","connected":false,"device":""}'

log() { echo "segno-bt-ctl: $*" >&2; }

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

have_bt() {
    command -v bluetoothctl >/dev/null 2>&1
}

bt() {
    bluetoothctl "$@"
}

ensure_powered() {
    bt power on >/dev/null 2>&1 || true
    bt system-alias "$ALIAS" >/dev/null 2>&1 || true
}

# Prints "NAME" of the first connected peer (empty when none). Prefers
# `bluetoothctl devices Connected` (BlueZ ≥5.65); falls back to `info`.
first_connected_device() {
    line=$(bt devices Connected 2>/dev/null | sed -n '/^Device /p' | head -n1 || true)
    if [ -n "$line" ]; then
        name=$(printf '%s\n' "$line" | cut -d' ' -f3-)
        [ -n "$name" ] || name=$(printf '%s\n' "$line" | awk '{print $2}')
        printf '%s' "$name"
        return 0
    fi
    tmp=$(mktemp)
    printf '%s\n' "$(bt devices 2>/dev/null || true)" >"$tmp"
    while IFS= read -r dline; do
        case "$dline" in
            Device\ *) ;;
            *) continue ;;
        esac
        address=$(printf '%s\n' "$dline" | awk '{print $2}')
        [ -n "$address" ] || continue
        info=$(bt info "$address" 2>/dev/null || true)
        printf '%s\n' "$info" | grep -q 'Connected: yes' || continue
        name=$(printf '%s\n' "$dline" | cut -d' ' -f3-)
        [ -n "$name" ] || name="$address"
        printf '%s' "$name"
        rm -f "$tmp"
        return 0
    done <"$tmp"
    rm -f "$tmp"
    return 0
}

# Emits one scan-list object for ADDRESS. Per-device detail comes out of
# `bluetoothctl info`; `Icon:` is passed through raw and mapped to a readable
# kind app-side, so an icon name bluez adds later reads as "unknown" rather
# than crashing the parse.
device_json() {
    address=$1
    name=$2
    in_range=$3
    info=$(bt info "$address" 2>/dev/null || true)
    paired=false
    connected=false
    icon=""
    printf '%s\n' "$info" | grep -q 'Paired: yes' && paired=true
    printf '%s\n' "$info" | grep -q 'Connected: yes' && connected=true
    icon=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*Icon: //p' | head -n1)
    printf '{"name":"%s","address":"%s","paired":%s,"connected":%s,"inRange":%s,"icon":"%s"}\n' \
        "$(json_escape "$name")" "$(json_escape "$address")" \
        "$paired" "$connected" "$in_range" "$(json_escape "$icon")"
}

do_status() {
    if ! have_bt; then
        echo "$STATUS_UNSUPPORTED"
        return 0
    fi
    # Start bluetoothd via systemd if present.
    if command -v systemctl >/dev/null 2>&1; then
        systemctl start bluetooth.service 2>/dev/null || true
    fi
    show=$(bt show 2>/dev/null || true)
    if [ -z "$show" ]; then
        echo "$STATUS_UNSUPPORTED"
        return 0
    fi
    powered=false
    discoverable=false
    advertising=false
    connected=false
    alias=""
    device=""
    printf '%s\n' "$show" | grep -q 'Powered: yes' && powered=true
    printf '%s\n' "$show" | grep -q 'Discoverable: yes' && discoverable=true
    # "Advertising: yes" appears when LE advertising is active.
    printf '%s\n' "$show" | grep -q 'Advertising: yes' && advertising=true
    alias=$(printf '%s\n' "$show" | sed -n 's/^[[:space:]]*Alias: //p' | head -n1)
    [ -n "$alias" ] || alias="$ALIAS"
    device=$(first_connected_device)
    [ -n "$device" ] && connected=true
    printf '{"supported":true,"powered":%s,"discoverable":%s,"advertising":%s,"alias":"%s","connected":%s,"device":"%s"}\n' \
        "$powered" "$discoverable" "$advertising" "$(json_escape "$alias")" \
        "$connected" "$(json_escape "$device")"
}

do_scan() {
    if ! have_bt; then
        echo '[]'
        return 1
    fi
    ensure_powered
    # Clear prior discoveries for a clean list, then timed scan.
    bt --timeout "$SCAN_SECONDS" scan on >/dev/null 2>&1 || true
    devices=$(bt devices 2>/dev/null || true)
    # Everything the last discovery actually saw. A paired device absent from
    # this list is still listed below, marked out of range: a pairing you
    # cannot see is still a pairing you may want to drop.
    seen=$(printf '%s\n' "$devices" | awk '/^Device /{print $2}')
    paired=$(bt devices Paired 2>/dev/null | awk '/^Device /{print $2}' || true)
    tmp=$(mktemp)
    printf '%s\n' "$devices" | while IFS= read -r line; do
        # "Device AA:BB:CC:DD:EE:FF Name here"
        case "$line" in
            Device\ *) ;;
            *) continue ;;
        esac
        address=$(printf '%s\n' "$line" | awk '{print $2}')
        name=$(printf '%s\n' "$line" | cut -d' ' -f3-)
        [ -n "$address" ] || continue
        [ -n "$name" ] || name="$address"
        device_json "$address" "$name" true
    done >"$tmp"
    # Paired-but-unseen devices, appended so the list is pairings ∪ sightings.
    for address in $paired; do
        printf '%s\n' "$seen" | grep -qx "$address" && continue
        info=$(bt info "$address" 2>/dev/null || true)
        name=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*Name: //p' | head -n1)
        [ -n "$name" ] || name="$address"
        device_json "$address" "$name" false >>"$tmp"
    done
    first=1
    printf '['
    while IFS= read -r obj; do
        [ -n "$obj" ] || continue
        if [ "$first" -eq 1 ]; then
            first=0
        else
            printf ','
        fi
        printf '%s' "$obj"
    done <"$tmp"
    printf ']\n'
    rm -f "$tmp"
}

do_power() {
    onoff=$1
    case "$onoff" in on|off) ;; *) log "power needs on|off"; return 2 ;; esac
    if [ "$onoff" = on ]; then
        ensure_powered
    else
        bt advertise off >/dev/null 2>&1 || true
        bt discoverable off >/dev/null 2>&1 || true
        bt power off >/dev/null 2>&1 || true
    fi
    echo '{}'
}

do_discoverable() {
    onoff=$1
    case "$onoff" in on|off) ;; *) log "discoverable needs on|off"; return 2 ;; esac
    ensure_powered
    bt discoverable "$onoff" >/dev/null
    if [ "$onoff" = on ]; then
        bt discoverable-timeout 0 >/dev/null 2>&1 || true
    fi
    echo '{}'
}

do_advertise() {
    onoff=$1
    case "$onoff" in on|off) ;; *) log "advertise needs on|off"; return 2 ;; esac
    ensure_powered
    if [ "$onoff" = on ]; then
        bt discoverable on >/dev/null
        bt discoverable-timeout 0 >/dev/null 2>&1 || true
        bt advertise on >/dev/null 2>&1 || true
    else
        bt advertise off >/dev/null 2>&1 || true
        bt discoverable off >/dev/null 2>&1 || true
    fi
    echo '{}'
}

do_pair() {
    address=$1
    ensure_powered
    # Discovery FIRST: bluez cannot pair with a device it has not seen in this
    # session, and an "unknown device" failure seconds later reads to the
    # operator as the device refusing rather than as the console never looking.
    bt --timeout "$SCAN_SECONDS" scan on >/dev/null 2>&1 || true
    bt pair "$address" >/dev/null
    # Trust BEFORE connecting, so the device may reconnect on its own after a
    # reboot. A paired-but-untrusted device has to be re-authorised by hand
    # every time, which is not what "paired" means to anyone standing on it.
    bt trust "$address" >/dev/null 2>&1 || true
    bt connect "$address" >/dev/null 2>&1 || true
    echo '{}'
}

do_connect() {
    address=$1
    ensure_powered
    bt connect "$address" >/dev/null
    echo '{}'
}

do_disconnect() {
    address=$1
    bt disconnect "$address" >/dev/null
    echo '{}'
}

do_forget() {
    address=$1
    # Drop the link and the trust before removing: `remove` on a connected,
    # trusted device leaves bluez re-adding it from the still-live link.
    bt disconnect "$address" >/dev/null 2>&1 || true
    bt untrust "$address" >/dev/null 2>&1 || true
    bt remove "$address" >/dev/null
    echo '{}'
}

usage() {
    log "usage: $0 status|scan|power on|off|discoverable on|off|advertise on|off|pair ADDR|connect ADDR|disconnect ADDR|forget ADDR"
    exit 2
}

[ $# -ge 1 ] || usage
verb=$1
shift

case "$verb" in
    status) do_status ;;
    scan) do_scan ;;
    power)
        [ $# -ge 1 ] || usage
        do_power "$1"
        ;;
    discoverable)
        [ $# -ge 1 ] || usage
        do_discoverable "$1"
        ;;
    advertise)
        [ $# -ge 1 ] || usage
        do_advertise "$1"
        ;;
    pair)
        [ $# -ge 1 ] || usage
        have_bt || { log "no bluetoothctl"; exit 1; }
        do_pair "$1"
        ;;
    connect)
        [ $# -ge 1 ] || usage
        have_bt || { log "no bluetoothctl"; exit 1; }
        do_connect "$1"
        ;;
    disconnect)
        [ $# -ge 1 ] || usage
        have_bt || { log "no bluetoothctl"; exit 1; }
        do_disconnect "$1"
        ;;
    forget)
        [ $# -ge 1 ] || usage
        have_bt || { log "no bluetoothctl"; exit 1; }
        do_forget "$1"
        ;;
    *) usage ;;
esac
