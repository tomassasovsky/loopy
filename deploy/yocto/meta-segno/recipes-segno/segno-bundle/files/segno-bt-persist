#!/bin/sh
# Keep BlueZ pairings on /data so an A/B OS update does not forget them.
#
# BlueZ writes adapters, link keys and device records under
# /var/lib/bluetooth, which lives on the rootfs — inside the RAUC slot. A
# device paired today survives reboots and is then silently unpaired by the
# next OTA, the same failure Wi-Fi and the SSH host keys already got fixed.
#
# Unlike NetworkManager (keyfile.path) and Dropbear (symlinkable key files),
# BlueZ has no redirect for its state directory, so this bind-mounts /data
# over it instead.
#
# See https://github.com/tomassasovsky/segno/issues/451
set -eu

DATA_DIR="${SEGNO_BT_DATA_DIR:-/data/bluetooth}"
STATE_DIR="${SEGNO_BT_STATE_DIR:-/var/lib/bluetooth}"
MOUNT="${SEGNO_MOUNT:-mount}"
MOUNTINFO="${SEGNO_MOUNTINFO:-/proc/self/mountinfo}"

log() { echo "segno-bt-persist: $*" >&2; }

# mountinfo field 5 is the mount point. Re-binding an already-bound directory
# would stack a second mount on every restart and hide the first.
already_bound() {
    [ -r "$MOUNTINFO" ] || return 1
    awk -v target="$STATE_DIR" '$5 == target { found = 1 } END { exit !found }' \
        "$MOUNTINFO"
}

has_entries() {
    [ -d "$1" ] || return 1
    [ -n "$(ls -A "$1" 2>/dev/null)" ]
}

if already_bound; then
    exit 0
fi

mkdir -p "$DATA_DIR" "$STATE_DIR"
chmod 700 "$DATA_DIR" "$STATE_DIR"

# First boot after enabling persistence: adopt whatever this slot already has,
# so a device paired before the switch is not lost by the reboot that enables
# it. Only when /data is still empty — the slot's copy is the stale one
# afterwards, and copying it over would resurrect deleted pairings.
if ! has_entries "$DATA_DIR" && has_entries "$STATE_DIR"; then
    log "adopting existing pairings from $STATE_DIR"
    cp -a "$STATE_DIR"/. "$DATA_DIR"/
fi

if ! "$MOUNT" --bind "$DATA_DIR" "$STATE_DIR"; then
    log "failed to bind $DATA_DIR over $STATE_DIR; pairings stay on this slot"
    exit 1
fi
