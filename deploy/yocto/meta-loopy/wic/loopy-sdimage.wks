# Loopy appliance SD layout (Phase 0 of #300): the stock Raspberry Pi boot + rootfs,
# plus a persistent DATA partition that OS/app updates never touch. User sessions,
# exports and config live on /data (see loopy-kiosk-launch + data.mount), so
# reflashing the rootfs does not destroy them.
#
# The data partition is seeded tiny here and grown to fill the whole card on first
# boot (loopy-growdata.service) — that keeps the flashed .wic image small (~rootfs
# size) instead of card-size, while still giving the appliance the entire card for
# loop/session storage.
#
# NOTE: single rootfs for now. Phase 1 re-lays this out as A/B (rootfs.A + rootfs.B)
# for atomic RAUC updates; /data stays put.
part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 130
part /     --source rootfs            --ondisk mmcblk0 --fstype=ext4 --label root --align 4096
part       --ondisk mmcblk0 --fstype=ext4 --label data --align 4096 --size 256

bootloader --ptable msdos
