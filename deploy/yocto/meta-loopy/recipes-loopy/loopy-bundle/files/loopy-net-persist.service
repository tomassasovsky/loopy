# Bind the durable Wi-Fi credential store on /data over the path
# NetworkManager reads, before NetworkManager reads it.
# See /usr/bin/loopy-net-persist. Idempotent; safe every boot.
[Unit]
Description=Loopy: persist NetworkManager connections on /data
After=data.mount
# Must land before NM loads its profiles, or it starts against the image's
# empty directory and the console comes up with no network — the exact symptom
# this exists to fix.
Before=NetworkManager.service
RequiresMountsFor=/data

[Service]
Type=oneshot
ExecStart=/usr/bin/loopy-net-persist
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
