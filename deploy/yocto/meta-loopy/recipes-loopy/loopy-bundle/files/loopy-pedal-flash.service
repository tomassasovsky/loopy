[Unit]
Description=Loopy: bring the pedal to the published firmware
# The flash used to run from the app while staging an OS update, which meant it
# always ran the OUTGOING image's flasher — a fix to flash-pedal could never
# apply on the update that delivered it (#444). Running it after the reboot
# puts the new image's own flasher in charge.
#
# Deliberately NOT ordered against loopy.service. Programming re-enumerates the
# pedal, and the app already handles that hotplug; ordering the kiosk behind a
# network wait would be a worse trade than a MIDI device blinking out for a few
# seconds.
Wants=network-online.target
After=network-online.target data.mount

[Service]
Type=oneshot
# `-`: no pedal attached, no network, or no firmware published are all ordinary
# states here, not boot failures. flash-pedal is idempotent and refuses before
# it writes anything, so the next boot simply tries again — which also closes
# the gap where a skipped flash was never retried until the next OS release.
ExecStart=-/usr/bin/loopy-update-ctl flash-pedal

[Install]
WantedBy=multi-user.target
