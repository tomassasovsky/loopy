[Unit]
Description=Grow Loopy /data partition to fill the SD card (runs before data.mount)
DefaultDependencies=no
After=local-fs-pre.target
Wants=local-fs-pre.target
# Must complete before /data is mounted — you cannot repartition a mounted device.
Before=data.mount local-fs.target
ConditionPathExists=/dev/mmcblk0p3

[Service]
Type=oneshot
ExecStart=/usr/bin/loopy-growdata
RemainAfterExit=yes

[Install]
WantedBy=local-fs.target
