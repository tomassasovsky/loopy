#!/bin/sh
# loopy-update-ctl — the privileged update helper the Flutter app drives.
#
# The app runs as the unprivileged kiosk user and does the read-only manifest
# check itself over HTTP; the privileged RAUC work happens here, invoked as
#   pkexec /usr/bin/loopy-update-ctl <verb>
# A polkit rule (loopy-update-ctl.rules) grants the kiosk user this one action
# without a password — no setuid.
#
# Verbs:
#   install   Download + verify + stage the newest published bundle to the
#             INACTIVE A/B slot. Prints "PROGRESS <0-100>" lines on stdout for
#             the UI, logs detail to stderr, and on success sets the staged +
#             pending markers. Does NOT reboot.
#   reboot    Reboot into the staged slot (the user's explicit "Restart to apply").
#   flash-pedal
#             Flash the published pedal firmware onto the attached Pro Micro
#             (#331 part D). Same PROGRESS/log contract as install. Exits 0 with
#             no work when the channel publishes no firmware or the pedal
#             already runs it, so it is safe to call unconditionally.
#
# Version model matches loopy-ota-check (semver, see its comparator comment):
# install only when the manifest advertises a version newer than the running
# one (/etc/loopy/build-version).
set -eu

BASE_URL="${LOOPY_UPDATE_BASE:-https://segno.aquiles.dev/updates/appliance}"
CHANNEL_OVERRIDE_FILE="${LOOPY_CHANNEL_OVERRIDE_FILE:-/data/loopy/update-channel}"
CHANNEL_FILE="${LOOPY_CHANNEL_FILE:-/etc/loopy/update-channel}"
CUR_FILE="${LOOPY_VERSION_FILE:-/etc/loopy/build-version}"
STAGED_FILE="/data/.ota-staged-version"   # on /data so it survives OS updates
PENDING_FLAG="/run/loopy-update-pending"  # tmpfs marker: "reboot to activate"

# What firmware the attached pedal is running, as last written by this script.
# On /data, NOT /etc: /etc lives in the A/B slot image, so an OS update would
# reset it and the app would forget what it flashed. This describes attached
# hardware, not the image.
PEDAL_STATE_FILE="${LOOPY_PEDAL_STATE_FILE:-/data/loopy/pedal-firmware-version}"
# Written when a flash fails, so the UI can say so instead of silently leaving
# a pedal that may be sitting in its bootloader.
PEDAL_FAIL_FILE="${LOOPY_PEDAL_FAIL_FILE:-/data/loopy/pedal-firmware-failed}"
# Overridable so the test harness can point at stubs and fixtures.
PEDAL_SERIAL_DIR="${LOOPY_PEDAL_SERIAL_DIR:-/dev/serial/by-id}"
AVRDUDE="${LOOPY_AVRDUDE:-avrdude}"
# Seconds to wait for the Caterina bootloader port to appear after the touch
# reset, and for the sketch to re-enumerate afterwards.
PEDAL_PORT_TIMEOUT="${LOOPY_PEDAL_PORT_TIMEOUT:-10}"

log() { echo "loopy-update-ctl: $*" >&2; }
progress() { echo "PROGRESS $1"; }

# Prefer the Settings-written override on /data, then the image-baked marker.
resolve_channel() {
    channel=$(cat "$CHANNEL_OVERRIDE_FILE" 2>/dev/null || true)
    channel=$(printf '%s' "$channel" | tr -d '[:space:]')
    if [ -z "$channel" ]; then
        channel=$(cat "$CHANNEL_FILE" 2>/dev/null || true)
        channel=$(printf '%s' "$channel" | tr -d '[:space:]')
    fi
    [ -n "$channel" ] || channel=production
    printf '%s\n' "$channel"
}

_int() { case "$1" in ''|*[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }

# semver_newer OLD NEW — succeeds (exit 0) if NEW is strictly greater than OLD.
# Accepts "X.Y.Z" and "X.Y.Z-<tag>.<n>" (e.g. "0.2.0-experimental.9"); a plain
# release outranks its own prerelease at the same X.Y.Z, and among two
# prereleases sharing a tag the trailing numeric build decides.
semver_newer() {
    old=$1 new=$2
    old_core=${old%%-*}; new_core=${new%%-*}
    old_maj=$(_int "${old_core%%.*}");   new_maj=$(_int "${new_core%%.*}")
    old_rest=${old_core#*.};             new_rest=${new_core#*.}
    old_min=$(_int "${old_rest%%.*}");   new_min=$(_int "${new_rest%%.*}")
    old_pat=$(_int "${old_rest#*.}");    new_pat=$(_int "${new_rest#*.}")

    [ "$new_maj" -gt "$old_maj" ] && return 0
    [ "$new_maj" -lt "$old_maj" ] && return 1
    [ "$new_min" -gt "$old_min" ] && return 0
    [ "$new_min" -lt "$old_min" ] && return 1
    [ "$new_pat" -gt "$old_pat" ] && return 0
    [ "$new_pat" -lt "$old_pat" ] && return 1

    case "$old" in *-*) old_pre=${old#*-} ;; *) old_pre="" ;; esac
    case "$new" in *-*) new_pre=${new#*-} ;; *) new_pre="" ;; esac
    if [ -z "$new_pre" ] && [ -n "$old_pre" ]; then return 0; fi
    if [ -n "$new_pre" ] && [ -z "$old_pre" ]; then return 1; fi
    if [ -z "$new_pre" ] && [ -z "$old_pre" ]; then return 1; fi

    old_tag=${old_pre%.*}; old_num=$(_int "${old_pre##*.}")
    new_tag=${new_pre%.*}; new_num=$(_int "${new_pre##*.}")
    [ "$old_tag" = "$new_tag" ] && [ "$new_num" -gt "$old_num" ]
}

do_install() {
    command -v rauc >/dev/null 2>&1 || { log "rauc not installed"; return 1; }
    channel=$(resolve_channel)
    current=$(cat "$CUR_FILE" 2>/dev/null || echo "0.0.0")

    work=$(mktemp -d /tmp/loopy-update.XXXXXX)
    trap 'rm -rf "$work"' EXIT
    progress 0

    if ! curl -fsSL --max-time 30 -o "$work/manifest.json" \
         "$BASE_URL/$channel/manifest.json"; then
        log "manifest fetch failed ($channel)"; return 1
    fi
    version=$(jq -r '.version // "0.0.0"' "$work/manifest.json" 2>/dev/null || echo "0.0.0")
    bundle=$(jq -r '.bundle // empty' "$work/manifest.json" 2>/dev/null || echo "")
    sha=$(jq -r '.sha256 // empty' "$work/manifest.json" 2>/dev/null || echo "")

    if [ -z "$bundle" ] || ! semver_newer "$current" "$version"; then
        log "nothing newer to install (published=$version current=$current)"
        return 1
    fi

    log "downloading v$version: $bundle"
    progress 5
    if ! curl -fsSL --max-time 1800 -o "$work/$bundle" \
         "$BASE_URL/$channel/$bundle"; then
        log "bundle download failed"; return 1
    fi
    progress 40

    # Defence in depth: manifest sha256 (RAUC also verifies the bundle's own
    # X.509 signature against the baked-in keyring — that is the real boundary).
    if [ -n "$sha" ]; then
        actual=$(sha256sum "$work/$bundle" | cut -d' ' -f1)
        if [ "$actual" != "$sha" ]; then
            log "sha256 mismatch (want $sha got $actual) — refusing"; return 1
        fi
    fi

    # Install to the inactive slot, mapping rauc's own "NN% ..." progress into
    # the 40..100 band. A fifo preserves rauc's exit code (a plain pipe loses it
    # under busybox sh, which has no reliable pipefail).
    log "installing v$version to the inactive slot"
    fifo="$work/rauc.fifo"
    mkfifo "$fifo"
    rauc install "$work/$bundle" >"$fifo" 2>&1 &
    rauc_pid=$!
    while IFS= read -r line; do
        pct=$(printf '%s' "$line" | sed -n 's/^ *\([0-9]\{1,3\}\)% .*/\1/p')
        [ -n "$pct" ] && progress $((40 + pct * 60 / 100))
        printf '%s\n' "$line" >&2
    done < "$fifo"
    if ! wait "$rauc_pid"; then
        log "rauc install failed"; return 1
    fi

    echo "$version" > "$STAGED_FILE" 2>/dev/null || true
    : > "$PENDING_FLAG" 2>/dev/null || true
    progress 100
    log "staged v$version to the inactive slot; reboot to apply"
}

# --- pedal firmware (#331 part D) -------------------------------------------
#
# The pedal has no A/B safety net. RAUC can roll the OS back to the other slot;
# a half-written 32U4 sits in its Caterina bootloader until something reflashes
# it, and on a sealed console there is no picker and no second USB port to do
# that from. So every gate below is about NOT starting a write that cannot
# finish, and about leaving a legible trail when one fails anyway.

# Prints the pedal's CDC device path, or nothing when it is not attached.
# by-id names are built from the USB product string, which is exactly what the
# app matches on, so the two agree on what "the pedal" means.
pedal_port() {
    for dev in "$PEDAL_SERIAL_DIR"/*VAMP_Loopstation*; do
        [ -e "$dev" ] || continue
        printf '%s\n' "$dev"
        return 0
    done
    return 1
}

# Waits up to PEDAL_PORT_TIMEOUT for a pedal port to appear (bootloader or
# sketch — both enumerate under the same product string).
wait_for_pedal_port() {
    i=0
    while [ "$i" -lt "$PEDAL_PORT_TIMEOUT" ]; do
        if port=$(pedal_port); then printf '%s\n' "$port"; return 0; fi
        i=$((i + 1))
        sleep 1
    done
    return 1
}

# The Caterina 1200bps touch: opening the CDC port at 1200 baud and dropping
# DTR makes the sketch jump to its bootloader, which re-enumerates as a
# different device. This is what `arduino-cli upload` does for you.
pedal_touch_reset() {
    port=$1
    stty -F "$port" 1200 hupcl 2>/dev/null || true
    sleep 2
}

do_flash_pedal() {
    command -v "$AVRDUDE" >/dev/null 2>&1 || { log "avrdude not installed"; return 1; }
    channel=$(resolve_channel)

    work=$(mktemp -d /tmp/loopy-pedal.XXXXXX)
    trap 'rm -rf "$work"' EXIT
    progress 0

    if ! curl -fsSL --max-time 30 -o "$work/manifest.json" \
         "$BASE_URL/$channel/manifest.json"; then
        log "manifest fetch failed ($channel)"; return 1
    fi

    hex=$(jq -r '.pedalFirmware.hex // empty' "$work/manifest.json" 2>/dev/null || echo "")
    fw_version=$(jq -r '.pedalFirmware.version // empty' "$work/manifest.json" 2>/dev/null || echo "")
    fw_sha=$(jq -r '.pedalFirmware.sha256 // empty' "$work/manifest.json" 2>/dev/null || echo "")
    fw_proto=$(jq -r '.pedalFirmware.protocolVersion // 0' "$work/manifest.json" 2>/dev/null || echo 0)

    # No firmware on this channel is a normal state, not a failure: every
    # manifest published before the artifact existed looks like this.
    if [ -z "$hex" ] || [ -z "$fw_version" ]; then
        log "no pedal firmware published on $channel; nothing to do"
        progress 100
        return 0
    fi

    current=$(cut -d' ' -f1 < "$PEDAL_STATE_FILE" 2>/dev/null || echo "0.0.0")
    if [ "$current" = "$fw_version" ]; then
        log "pedal already runs $fw_version; nothing to do"
        progress 100
        return 0
    fi

    # GATE 1 — the pedal must be here before a single byte is downloaded.
    # Flashing "the pedal" while it is unplugged would either do nothing or,
    # worse, write this image to whatever else answers to the port.
    if ! port=$(pedal_port); then
        log "no pedal attached; refusing to flash"
        return 1
    fi
    log "pedal at $port; publishing $fw_version (current $current)"

    progress 10
    if ! curl -fsSL --max-time 300 -o "$work/$hex" "$BASE_URL/$channel/$hex"; then
        log "firmware download failed"; return 1
    fi
    progress 30

    # GATE 2 — checksum before writing. Unlike the RAUC bundle, a .hex carries
    # no signature of its own, so this is the ONLY integrity check standing
    # between a corrupted download and a bricked pedal. A missing checksum is
    # therefore refused rather than skipped (install treats it as optional
    # because RAUC verifies the bundle signature independently).
    if [ -z "$fw_sha" ]; then
        log "manifest publishes no sha256 for $hex; refusing to flash unverified firmware"
        return 1
    fi
    actual=$(sha256sum "$work/$hex" | cut -d' ' -f1)
    if [ "$actual" != "$fw_sha" ]; then
        log "sha256 mismatch (want $fw_sha got $actual) — refusing"; return 1
    fi
    progress 40

    # GATE 3 — still attached after the download (which can take a while).
    if ! pedal_port >/dev/null; then
        log "pedal disappeared during download; refusing to flash"
        return 1
    fi

    log "resetting $port into the bootloader"
    pedal_touch_reset "$port"
    if ! boot_port=$(wait_for_pedal_port); then
        log "bootloader port never appeared; pedal left untouched"
        return 1
    fi
    progress 50

    # No -V: avrdude verifies the readback against the image by default, and
    # that verification is the difference between "wrote something" and "wrote
    # this". Losing it to save a few seconds would defeat the point.
    log "flashing $hex via $boot_port"
    if ! "$AVRDUDE" -p atmega32u4 -c avr109 -P "$boot_port" -b 57600 \
         -U "flash:w:$work/$hex:i" >&2; then
        log "avrdude failed; pedal may be sitting in its bootloader"
        mkdir -p "$(dirname "$PEDAL_FAIL_FILE")" 2>/dev/null || true
        echo "$fw_version" > "$PEDAL_FAIL_FILE" 2>/dev/null || true
        return 1
    fi
    progress 90

    # GATE 4 — the sketch has to come back. avrdude exiting 0 means the write
    # verified, not that the firmware runs; if the pedal never re-enumerates,
    # say so rather than recording a version that is not actually running.
    if ! wait_for_pedal_port >/dev/null; then
        log "pedal did not re-enumerate after flashing"
        mkdir -p "$(dirname "$PEDAL_FAIL_FILE")" 2>/dev/null || true
        echo "$fw_version" > "$PEDAL_FAIL_FILE" 2>/dev/null || true
        return 1
    fi

    # "<semver> <protocol>" — the app reads field 2 to know what wire version
    # it may encode at, which is the whole point of recording this.
    mkdir -p "$(dirname "$PEDAL_STATE_FILE")" 2>/dev/null || true
    echo "$fw_version $fw_proto" > "$PEDAL_STATE_FILE"
    rm -f "$PEDAL_FAIL_FILE" 2>/dev/null || true
    progress 100
    log "pedal flashed to $fw_version (protocol v$fw_proto)"
}

case "${1:-}" in
    install)     do_install ;;
    flash-pedal) do_flash_pedal ;;
    reboot)      log "rebooting into the staged slot"; exec systemctl reboot ;;
    *)           log "usage: loopy-update-ctl {install|flash-pedal|reboot}"; exit 2 ;;
esac
