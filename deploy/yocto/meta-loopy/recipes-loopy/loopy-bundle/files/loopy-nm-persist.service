[Unit]
Description=Loopy: NetworkManager connections on /data (survive OTA)
DefaultDependencies=no
Requires=data.mount
After=data.mount
Before=NetworkManager.service network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/loopy-nm-persist

[Install]
WantedBy=NetworkManager.service
