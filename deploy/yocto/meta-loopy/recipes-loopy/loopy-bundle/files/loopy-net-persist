#!/bin/sh
# loopy-net-persist — keep saved Wi-Fi networks across reboots and OS updates.
#
# NetworkManager stores connection profiles (SSID + PSK) in
# /etc/NetworkManager/system-connections. On this appliance /etc lives INSIDE
# the RAUC A/B slot image, so every OS update replaces it — the console would
# drop off the network after each update, including off the very path that
# delivered it. The image is also rebuilt from scratch per release, so nothing
# written there is ours to keep.
#
# So the real store lives on /data (the one partition updates never touch, same
# as the staged-update marker and the flashed pedal firmware version) and is
# bind-mounted over the path NetworkManager expects. NM needs no configuration
# and no awareness of this.
#
# A bind mount rather than a symlink: NetworkManager requires the directory to
# be root-owned and 0700, and refuses profiles it considers world-readable. A
# mount keeps the kernel's view of the path identical to a real directory,
# where a symlink invites both NM and its SELinux/permission checks to reason
# about the link target instead.
set -eu

SRC="${LOOPY_NET_STORE:-/data/loopy/NetworkManager/system-connections}"
DST="${LOOPY_NET_DST:-/etc/NetworkManager/system-connections}"

log() { echo "loopy-net-persist: $*" >&2; }

# Without /data there is nothing durable to bind; leaving NM on its image-local
# directory is strictly better than failing the boot over it.
if ! grep -qs ' /data ' /proc/mounts; then
    log "/data not mounted; leaving NetworkManager on the rootfs (nothing will persist)"
    exit 0
fi

mkdir -p "$SRC"
# NetworkManager ignores profiles whose file mode is looser than 0600 and warns
# on a group/world-accessible directory. These are credentials.
chmod 0700 "$SRC"
chown root:root "$SRC" 2>/dev/null || true

mkdir -p "$DST"

if grep -qs " $DST " /proc/mounts; then
    log "already bound"
    exit 0
fi

# First run after enabling this: adopt whatever the image already had, so a
# network joined before the switch is not silently lost by it.
for f in "$DST"/*; do
    [ -e "$f" ] || continue
    if [ ! -e "$SRC/$(basename "$f")" ]; then
        log "adopting existing profile $(basename "$f")"
        cp -a "$f" "$SRC/" || true
    fi
done

mount --bind "$SRC" "$DST"
log "bound $DST -> $SRC"
