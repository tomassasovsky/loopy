#!/bin/sh
# loopy-brightness-ctl — privileged display-brightness helper (DDC/CI).
#
# Verbs (stdout = compact JSON or a bare percent; detail on stderr):
#   supported   {"supported":true|false}
#   get         {"supported":bool,"percent":0-100}
#   set <0-100> {"supported":bool,"percent":0-100}
#
# Uses ddcutil VCP 0x10 (brightness). HDMI panels without DDC report unsupported.
set -eu

log() { echo "loopy-brightness-ctl: $*" >&2; }

have_ddc() {
    command -v ddcutil >/dev/null 2>&1
}

detect_ok() {
    have_ddc || return 1
    # detect exits 0 when at least one capable display is found.
    ddcutil detect --brief 2>/dev/null | grep -q '^Display'
}

do_supported() {
    if detect_ok; then
        echo '{"supported":true}'
    else
        echo '{"supported":false}'
    fi
}

read_percent() {
    # Typical: "VCP code 0x10 (Brightness): current value =    50, max value =   100"
    out=$(ddcutil getvcp 10 2>/dev/null || true)
    cur=$(printf '%s\n' "$out" | sed -n 's/.*current value *= *\([0-9][0-9]*\).*/\1/p' | head -n1)
    max=$(printf '%s\n' "$out" | sed -n 's/.*max value *= *\([0-9][0-9]*\).*/\1/p' | head -n1)
    [ -n "$cur" ] || return 1
    [ -n "$max" ] || max=100
    if [ "$max" -le 0 ]; then
        echo 0
        return 0
    fi
    # Scale to 0-100.
    echo $((cur * 100 / max))
}

do_get() {
    if ! detect_ok; then
        echo '{"supported":false,"percent":80}'
        return 0
    fi
    pct=$(read_percent) || pct=80
    printf '{"supported":true,"percent":%s}\n' "$pct"
}

do_set() {
    pct=$1
    case "$pct" in ''|*[!0-9]*) log "set needs integer 0-100"; return 2 ;; esac
    if [ "$pct" -gt 100 ]; then pct=100; fi
    if ! detect_ok; then
        echo '{"supported":false,"percent":'"$pct"'}'
        return 0
    fi
    ddcutil setvcp 10 "$pct" >/dev/null
    printf '{"supported":true,"percent":%s}\n' "$pct"
}

usage() {
    log "usage: $0 supported|get|set <0-100>"
    exit 2
}

[ $# -ge 1 ] || usage
verb=$1
shift

case "$verb" in
    supported) do_supported ;;
    get) do_get ;;
    set)
        [ $# -ge 1 ] || usage
        do_set "$1"
        ;;
    *) usage ;;
esac
