#!/bin/sh
# Grow the /data partition to fill the SD card, once, on first boot.
#
# The wic image seeds /data tiny (so the flashed image stays small); this extends
# partition 3 to the end of the disk (MBR, online) and then grows the ext4
# filesystem into it. Idempotent + guarded by a flag ON /data itself, so it runs
# exactly once per card and never on a reflash that keeps the data partition.
set -eu

DEV=/dev/mmcblk0
PART=3
FLAG=/data/.loopy-data-grown

# /data must be mounted (the flag lives on it, and resize2fs grows it online).
if ! grep -qs ' /data ' /proc/mounts; then
    echo "loopy-growdata: /data not mounted, skipping" >&2
    exit 0
fi

if [ -f "$FLAG" ]; then
    exit 0
fi

# Only the last partition can grow into trailing free space. Extend the partition
# table entry to 100% (parted edits + tells the kernel; online for a mounted ext4),
# then online-resize the filesystem. Set the done-flag ONLY on full success, so a
# transient failure (or a missing tool) retries on the next boot instead of latching
# a partially-grown /data forever. A smaller /data still works meanwhile — no boot
# loop (the service is a flag-guarded oneshot, not Restart=).
if parted -s "$DEV" resizepart "$PART" 100% && resize2fs "${DEV}p${PART}"; then
    touch "$FLAG"
    echo "loopy-growdata: /data grown to fill the card" >&2
else
    echo "loopy-growdata: grow failed (tools missing / transient) — will retry next boot" >&2
fi
