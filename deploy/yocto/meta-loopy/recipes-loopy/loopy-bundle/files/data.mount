[Unit]
Description=Loopy persistent data partition (/data)
# The data partition survives OS/app updates; the app stores everything here.
# loopy.service pulls this in via RequiresMountsFor=/data.
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target

[Mount]
What=/dev/disk/by-label/data
Where=/data
Type=ext4
Options=noatime

[Install]
WantedBy=local-fs.target
