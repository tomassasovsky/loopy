#!/bin/sh
# loopy-data-grow — expand the persistent /data partition to fill the SD card.
#
# The WIC image seeds p7 (label "data") at 2 GiB inside an MBR extended
# container (p4). On a larger card the rest of the media is unused until this
# oneshot grows p4 then p7 to the end of the disk and runs resize2fs.
#
# Idempotent: safe every boot. Never touches tryboot/bootA/bootB (p1–p3) or
# the RAUC rootfs slots (p5–p6). Delivered via OTA (rootfs) so existing cards
# grow after update + reboot without a reflash.
#
# Layout locked by deploy/yocto/meta-loopy/wic/loopy-tryboot.wks:
#   p4 = extended, p7 = data (logical).

set -eu

LABEL_LINK=/dev/disk/by-label/data
EXTENDED_PART=4
LOG_TAG=loopy-data-grow

log() {
  echo "$LOG_TAG: $*"
}

die() {
  echo "$LOG_TAG: ERROR: $*" >&2
  exit 1
}

command -v parted >/dev/null 2>&1 || die "parted not found"
command -v resize2fs >/dev/null 2>&1 || die "resize2fs not found"

[ -e "$LABEL_LINK" ] || die "missing $LABEL_LINK (data partition not present?)"

DATA_DEV=$(readlink -f "$LABEL_LINK") || die "cannot resolve $LABEL_LINK"
case "$DATA_DEV" in
  *p[0-9]*)
    DISK=${DATA_DEV%p*}
    DATA_PART=${DATA_DEV##*p}
    ;;
  *)
    die "unexpected data device path: $DATA_DEV (expected …pN, e.g. mmcblk0p7)"
    ;;
esac

[ -b "$DISK" ] || die "disk $DISK is not a block device"
[ "$DATA_PART" = "7" ] || die "data is on ${DISK}p${DATA_PART}, expected p7 (refusing to grow unknown layout)"

# Machine-readable table: BYT; / line 2 = disk; then one line per partition.
# Fields: number:start:end:size:...
parted_print() {
  parted -sm "$DISK" unit s print
}

disk_end_s=$(parted_print | awk -F: 'NR==2 { gsub(/s$/,"",$2); print $2 }')
[ -n "$disk_end_s" ] || die "cannot read disk size from parted"

p4_end_s=$(parted_print | awk -F: -v n="$EXTENDED_PART" '$1==n { gsub(/s$/,"",$3); print $3 }')
[ -n "$p4_end_s" ] || die "cannot find extended partition p${EXTENDED_PART}"

p7_end_s=$(parted_print | awk -F: -v n="$DATA_PART" '$1==n { gsub(/s$/,"",$3); print $3 }')
[ -n "$p7_end_s" ] || die "cannot find data partition p${DATA_PART}"

# Leave a tiny slack so end-of-disk alignment quirks don't spuriously "need grow".
SLACK_S=2048
need_part_grow=0
if [ "$((p4_end_s + SLACK_S))" -lt "$disk_end_s" ]; then
  need_part_grow=1
elif [ "$((p7_end_s + SLACK_S))" -lt "$p4_end_s" ]; then
  need_part_grow=1
fi

resize_part() {
  part="$1"
  # Prefer script mode; some parted builds still prompt when the kernel holds
  # the old table — fall back to pretend-input-tty and affirm.
  if parted -s -a opt "$DISK" resizepart "$part" 100%; then
    return 0
  fi
  printf 'Yes\nYes\nYes\n' | parted ---pretend-input-tty "$DISK" resizepart "$part" 100%
}

if [ "$need_part_grow" = 1 ]; then
  log "growing extended p${EXTENDED_PART} then data p${DATA_PART} on $DISK to fill ${disk_end_s}s"
  resize_part "$EXTENDED_PART" || die "failed to grow extended p${EXTENDED_PART}"
  resize_part "$DATA_PART" || die "failed to grow data p${DATA_PART}"

  if command -v partprobe >/dev/null 2>&1; then
    partprobe "$DISK" 2>/dev/null || true
  fi
  # Tell the kernel to re-read the partition table for this disk.
  if [ -w "/sys/block/${DISK#/dev/}/uevent" ]; then
    echo change > "/sys/block/${DISK#/dev/}/uevent" 2>/dev/null || true
  fi
  # Give udev a moment to refresh /dev/disk/by-label/data after the size change.
  sleep 1
  DATA_DEV=$(readlink -f "$LABEL_LINK") || die "lost $LABEL_LINK after grow"
  log "partition table updated; data device=$DATA_DEV"
else
  log "partitions already fill $DISK (disk_end=${disk_end_s}s p4_end=${p4_end_s}s p7_end=${p7_end_s}s)"
fi

# Online grow is supported for ext4; no-op if the fs already matches the partition.
log "resize2fs $DATA_DEV"
resize2fs "$DATA_DEV" || die "resize2fs failed on $DATA_DEV"
log "done"
exit 0
