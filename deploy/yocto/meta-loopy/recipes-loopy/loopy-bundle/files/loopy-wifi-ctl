#!/bin/sh
# loopy-wifi-ctl — privileged WiFi helper the Flutter app drives.
#
# Verbs (stdout = compact JSON; detail on stderr):
#   status                 {supported,enabled,connected,ssid,ip,signal}
#   scan                   [{ssid,signal,secured}, ...]
#   connect <ssid> [psk]   {} on success (waits for activation)
#   disconnect             {}
#   forget <ssid>          {}
#   radio on|off           {}  (Control Center tap toggle)
#
# Backend selection:
#   1) NetworkManager / nmcli when present (Yocto NM images)
#   2) else wpa_cli + wpa_supplicant (older images / live-patched helpers)
# Returning supported:false only when *neither* stack is available — otherwise
# Control Center shows "WiFi only on appliance" even though the radio works.
set -eu

IFACE="${LOOPY_WIFI_IFACE:-wlan0}"
# Keep wpa_supplicant.conf on /data so the fallback path survives A/B OTA too.
CONF="${LOOPY_WPA_CONF:-/data/wpa_supplicant/wpa_supplicant-${IFACE}.conf}"
CTRL_DIR="${LOOPY_WPA_CTRL:-/run/wpa_supplicant}"
CONNECT_WAIT_SECS="${LOOPY_WIFI_CONNECT_TIMEOUT:-45}"
# NM gets a shorter budget so we can fall back to wpa_supplicant quickly.
NM_CONNECT_WAIT_SECS="${LOOPY_WIFI_NM_CONNECT_TIMEOUT:-20}"
CONNECT_TIMEOUT_SECS="${LOOPY_WIFI_CONNECT_TIMEOUT:-45}"
# Prefer WiFi over the ephemeral wired profile (autoconnect-priority -999).
WIFI_AUTOCONNECT_PRIORITY="${LOOPY_WIFI_AUTOCONNECT_PRIORITY:-100}"

log() { echo "loopy-wifi-ctl: $*" >&2; }

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

have_nmcli() { command -v nmcli >/dev/null 2>&1; }
have_wpa_cli() { command -v wpa_cli >/dev/null 2>&1; }

# Prefer NM when it still owns the iface; once we hand wlan0 to wpa
# (managed no), keep using wpa so status/scan/connect stay coherent.
wifi_backend() {
    if have_nmcli; then
        nm_state=$(nmcli -t -f GENERAL.STATE device show "$IFACE" 2>/dev/null \
            | head -n1 || true)
        case "$nm_state" in
            *unmanaged*)
                if have_wpa_cli; then
                    printf '%s\n' wpa
                    return 0
                fi
                ;;
        esac
        printf '%s\n' nm
    elif have_wpa_cli; then
        printf '%s\n' wpa
    else
        printf '%s\n' none
    fi
}

# Release wlan0 from NetworkManager so wpa_supplicant can own association.
# Never killall wpa_supplicant — that breaks NM's dbus-owned instance.
nm_release_wifi() {
    have_nmcli || return 0
    nmcli device disconnect "$IFACE" >/dev/null 2>&1 || true
    nmcli device set "$IFACE" managed no >/dev/null 2>&1 || true
}

# Ask NetworkManager to take wlan0 back (e.g. after forget/radio-off cleanup).
nm_claim_wifi() {
    have_nmcli || return 0
    nmcli device set "$IFACE" managed yes >/dev/null 2>&1 || true
}

dhcp_wifi() {
    [ -n "$(iface_ip)" ] && return 0
    if command -v udhcpc >/dev/null 2>&1; then
        udhcpc -i "$IFACE" -n -q -t 5 >/dev/null 2>&1 || true
    elif command -v dhclient >/dev/null 2>&1; then
        dhclient -1 "$IFACE" >/dev/null 2>&1 || true
    fi
    [ -n "$(iface_ip)" ]
}

disable_powersave() {
    command -v iw >/dev/null 2>&1 || return 0
    iw dev "$IFACE" set power_save off >/dev/null 2>&1 || true
}

iface_ip() {
    ip -4 -o addr show dev "$IFACE" 2>/dev/null \
        | awk '{print $4}' | cut -d/ -f1 | head -n1
}

iface_enabled() {
    ip -o link show "$IFACE" 2>/dev/null | grep -Eq '[,<]UP[,>]'
}

# ---------- NetworkManager path ----------

map_connect_error() {
    err=$1
    lower=$(printf '%s' "$err" | tr '[:upper:]' '[:lower:]')
    if printf '%s' "$lower" | grep -qE \
        'secrets were required|no secrets|property is missing|wrong[^[:space:]]*password'
    then
        log "authentication failed (wrong password?)"
    elif printf '%s' "$lower" | grep -qE \
        '802\.1x|supplicant took too long|timeout|took too long'
    then
        log "timed out waiting for association"
    else
        log "connection failed: $err"
    fi
}

do_status_nm() {
    wifi_radio=$(nmcli -t -f WIFI radio 2>/dev/null || echo disabled)
    enabled=false
    case "$wifi_radio" in enabled|on) enabled=true ;; esac

    if [ "$enabled" != true ]; then
        echo '{"supported":true,"enabled":false,"connected":false,"ssid":"","ip":"","signal":0}'
        return 0
    fi

    state=$(nmcli -t -f GENERAL.STATE device show "$IFACE" 2>/dev/null \
        | sed -n 's/^GENERAL.STATE://p' | head -n1)
    connected=false
    case "$state" in 100\ *|*\(connected\)*) connected=true ;; esac

    ssid=$(nmcli -t -f GENERAL.CONNECTION device show "$IFACE" 2>/dev/null \
        | sed -n 's/^GENERAL.CONNECTION://p' | head -n1)
    case "$ssid" in ''|--*) ssid= ;; esac

    ip=$(nmcli -t -f IP4.ADDRESS device show "$IFACE" 2>/dev/null \
        | sed -n 's/^IP4.ADDRESS\[[0-9]*\]://p' | head -n1 | cut -d/ -f1)

    signal=0
    if [ "$connected" = true ] && [ -n "$ssid" ]; then
        signal=$(nmcli -t -f IN-USE,SSID,SIGNAL device wifi list ifname "$IFACE" 2>/dev/null \
            | awk -F: -v s="$ssid" '$1=="*" && $2==s {print $3; exit}')
        [ -n "$signal" ] || signal=0
    fi

    printf '{"supported":true,"enabled":true,"connected":%s,"ssid":"%s","ip":"%s","signal":%s}\n' \
        "$connected" "$(json_escape "${ssid:-}")" "$(json_escape "${ip:-}")" "$signal"
}

do_radio_nm() {
    onoff=$1
    case "$onoff" in on|off) ;; *) log "radio needs on|off"; return 2 ;; esac
    nmcli radio wifi "$onoff" >/dev/null
    echo '{}'
}

do_scan_nm() {
    nmcli radio wifi on >/dev/null 2>&1 || true
    nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1 || true
    sleep 2

    raw=$(mktemp)
    ranked=$(mktemp)
    nmcli -t -f SSID,SIGNAL,SECURITY device wifi list ifname "$IFACE" 2>/dev/null >"$raw" || true

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        security=${line##*:}
        rest=${line%:*}
        signal=${rest##*:}
        ssid=${rest%:*}
        [ -n "$ssid" ] || continue
        case "$ssid" in --*) continue ;; esac
        secured=true
        case "$security" in ''|--*) secured=false ;; esac
        ssid_safe=$(printf '%s' "$ssid" | tr '\t' ' ')
        printf '%s\t%s\t%s\n' "$ssid_safe" "${signal:-0}" "$secured"
    done <"$raw" | awk -F'\t' '
        {
            ssid=$1; sig=$2+0; sec=$3
            if (!(ssid in best) || sig > best[ssid]) {
                best[ssid]=sig
                secured[ssid]=sec
            }
        }
        END {
            for (s in best) printf "%s\t%d\t%s\n", s, best[s], secured[s]
        }
    ' | sort -t"$(printf '\t')" -k2,2nr >"$ranked"

    first=1
    printf '['
    while IFS="$(printf '\t')" read -r ssid signal secured; do
        [ -n "$ssid" ] || continue
        if [ "$first" -eq 1 ]; then
            first=0
        else
            printf ','
        fi
        printf '{"ssid":"%s","signal":%s,"secured":%s}' \
            "$(json_escape "$ssid")" "$signal" "$secured"
    done <"$ranked"
    printf ']\n'
    rm -f "$raw" "$ranked"
}

do_forget_nm() {
    ssid=$1
    nmcli -t -f UUID,NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$3 ~ /wireless|wifi/ {print $1"\t"$2}' \
        | while IFS="$(printf '\t')" read -r uuid name; do
            [ -n "$uuid" ] || continue
            profile_ssid=$(nmcli -t -f 802-11-wireless.ssid connection show "$uuid" 2>/dev/null \
                | sed -n 's/^802-11-wireless.ssid://p')
            if [ "$name" = "$ssid" ] || [ "$profile_ssid" = "$ssid" ]; then
                nmcli connection delete uuid "$uuid" >/dev/null 2>&1 || true
            fi
        done
    echo '{}'
}

do_connect_nm() {
    ssid=$1
    psk=${2:-}
    nmcli radio wifi on >/dev/null 2>&1 || true
    # If a prior wpa takeover left the iface unmanaged, reclaim it for NM.
    nm_claim_wifi
    disable_powersave
    do_forget_nm "$ssid" >/dev/null 2>&1 || true

    errf=$(mktemp)
    passf=
    set +e
    if [ -n "$psk" ]; then
        # Create the profile without embedding the PSK in argv, then activate
        # via passwd-file. On this image `connection up` after `wifi-sec.psk=…`
        # often fails immediately with "Secrets were required".
        nmcli connection add type wifi ifname "$IFACE" con-name "$ssid" \
            ssid "$ssid" \
            wifi-sec.key-mgmt wpa-psk \
            wifi-sec.auth-alg open \
            connection.autoconnect yes \
            connection.autoconnect-priority "$WIFI_AUTOCONNECT_PRIORITY" \
            802-11-wireless.powersave 2 \
            >"$errf" 2>&1
        rc=$?
        if [ "$rc" -eq 0 ]; then
            passf=$(mktemp)
            chmod 600 "$passf"
            printf '802-11-wireless-security.psk:%s\n' "$psk" >"$passf"
            nmcli --wait "$NM_CONNECT_WAIT_SECS" connection up "$ssid" \
                passwd-file "$passf" >"$errf" 2>&1
            rc=$?
            # Persist secrets into the keyfile for autoconnect after reboot.
            if [ "$rc" -eq 0 ]; then
                nmcli connection modify "$ssid" \
                    wifi-sec.psk "$psk" wifi-sec.psk-flags 0 \
                    >/dev/null 2>&1 || true
            fi
        fi
    else
        nmcli connection add type wifi ifname "$IFACE" con-name "$ssid" \
            ssid "$ssid" \
            connection.autoconnect yes \
            connection.autoconnect-priority "$WIFI_AUTOCONNECT_PRIORITY" \
            802-11-wireless.powersave 2 \
            >"$errf" 2>&1 \
            && nmcli --wait "$NM_CONNECT_WAIT_SECS" connection up "$ssid" \
                >"$errf" 2>&1
        rc=$?
    fi
    set -e
    rm -f "$passf"
    if [ "$rc" -ne 0 ]; then
        map_connect_error "$(cat "$errf")"
        rm -f "$errf"
        return 1
    fi
    rm -f "$errf"
    echo '{}'
}

do_disconnect_nm() {
    nmcli device disconnect "$IFACE" >/dev/null 2>&1 || true
    echo '{}'
}

# ---------- wpa_supplicant path ----------

wpa_ok() {
    out=$(wpa_cli -i "$IFACE" "$@" 2>&1) || true
    case "$out" in
        OK*) return 0 ;;
        *)
            log "wpa_cli $* -> $out"
            return 1
            ;;
    esac
}

ensure_conf() {
    mkdir -p "$(dirname "$CONF")"
    if [ ! -f "$CONF" ]; then
        cat >"$CONF" <<EOF
ctrl_interface=DIR=${CTRL_DIR}
update_config=1
EOF
        return 0
    fi
    if grep -q 'GROUP=netdev' "$CONF" 2>/dev/null \
        && ! grep -q '^netdev:' /etc/group 2>/dev/null; then
        sed -i 's/ GROUP=netdev//' "$CONF"
    fi
}

ensure_wpa() {
    ensure_conf
    mkdir -p "$CTRL_DIR"
    if wpa_cli -i "$IFACE" ping >/dev/null 2>&1; then
        disable_powersave
        return 0
    fi
    if command -v systemctl >/dev/null 2>&1 \
        && systemctl start "wpa_supplicant@${IFACE}.service" 2>/dev/null; then
        sleep 0.5
    fi
    if ! wpa_cli -i "$IFACE" ping >/dev/null 2>&1; then
        if ! command -v wpa_supplicant >/dev/null 2>&1; then
            log "wpa_supplicant not installed"
            return 1
        fi
        wpa_supplicant -B -i "$IFACE" -c "$CONF" || true
        sleep 0.5
    fi
    disable_powersave
    wpa_cli -i "$IFACE" ping >/dev/null 2>&1
}

wpa_state() {
    wpa_cli -i "$IFACE" status 2>/dev/null | sed -n 's/^wpa_state=//p' | head -n1
}

network_temp_disabled() {
    id=$1
    wpa_cli -i "$IFACE" list_networks 2>/dev/null \
        | awk -v id="$id" 'NR>1 && $1==id {print; exit}' \
        | grep -q 'TEMP-DISABLED'
}

wait_for_completed() {
    id=$1
    i=0
    while [ "$i" -lt "$CONNECT_TIMEOUT_SECS" ]; do
        state=$(wpa_state)
        if [ "$state" = "COMPLETED" ]; then
            return 0
        fi
        # brcmfmac often sticks on ASSOCIATED without ever reporting
        # COMPLETED even after the 4-way handshake is done — probe DHCP.
        if [ "$state" = "ASSOCIATED" ]; then
            dhcp_wifi || true
            if [ -n "$(iface_ip)" ]; then
                return 0
            fi
        fi
        if network_temp_disabled "$id"; then
            log "authentication failed for network $id (wrong password?)"
            return 1
        fi
        sleep 1
        i=$((i + 1))
    done
    state=$(wpa_state)
    if [ "$state" = "COMPLETED" ]; then
        return 0
    fi
    if [ "$state" = "ASSOCIATED" ]; then
        dhcp_wifi || true
        [ -n "$(iface_ip)" ] && return 0
    fi
    log "timed out waiting for association (state=${state:-unknown})"
    return 1
}

do_status_wpa() {
    enabled=false
    iface_enabled && enabled=true
    if [ "$enabled" != true ]; then
        echo '{"supported":true,"enabled":false,"connected":false,"ssid":"","ip":"","signal":0}'
        return 0
    fi
    state=$(wpa_cli -i "$IFACE" status 2>/dev/null || true)
    if [ -z "$state" ]; then
        echo '{"supported":true,"enabled":true,"connected":false,"ssid":"","ip":"","signal":0}'
        return 0
    fi
    wpa_st=$(printf '%s\n' "$state" | sed -n 's/^wpa_state=//p' | head -n1)
    ssid=$(printf '%s\n' "$state" | sed -n 's/^ssid=//p' | head -n1)
    signal=$(printf '%s\n' "$state" | sed -n 's/^rssi=//p' | head -n1)
    if [ -z "$signal" ] || [ "$signal" = "0" ]; then
        signal=$(wpa_cli -i "$IFACE" signal_poll 2>/dev/null \
            | sed -n 's/^RSSI=//p' | head -n1)
    fi
    [ -n "$signal" ] || signal=0
    ip=$(iface_ip)
    connected=false
    if [ "$wpa_st" = "COMPLETED" ] || {
        [ "$wpa_st" = "ASSOCIATED" ] && [ -n "$ip" ]
    }; then
        connected=true
    fi
    printf '{"supported":true,"enabled":true,"connected":%s,"ssid":"%s","ip":"%s","signal":%s}\n' \
        "$connected" "$(json_escape "$ssid")" "$(json_escape "${ip:-}")" "$signal"
}

do_radio_wpa() {
    onoff=$1
    case "$onoff" in on|off) ;; *) log "radio needs on|off"; return 2 ;; esac
    if [ "$onoff" = on ]; then
        ip link set "$IFACE" up 2>/dev/null || true
        ensure_wpa || return 1
        disable_powersave
    else
        wpa_cli -i "$IFACE" disconnect >/dev/null 2>&1 || true
        ip link set "$IFACE" down 2>/dev/null || true
    fi
    echo '{}'
}

do_scan_wpa() {
    ensure_wpa || {
        echo '[]'
        return 1
    }
    disable_powersave
    wpa_cli -i "$IFACE" scan >/dev/null 2>&1 || true
    sleep 3
    results=$(wpa_cli -i "$IFACE" scan_results 2>/dev/null | tail -n +2 || true)
    if [ -z "$results" ]; then
        sleep 2
        results=$(wpa_cli -i "$IFACE" scan_results 2>/dev/null | tail -n +2 || true)
    fi
    tmp=$(mktemp)
    printf '%s\n' "$results" | while IFS= read -r line; do
        [ -n "$line" ] || continue
        ssid=$(printf '%s\n' "$line" | awk '{
            for (i=5; i<=NF; i++) printf "%s%s", (i>5?" ":""), $i
        }')
        [ -n "$ssid" ] || continue
        signal=$(printf '%s\n' "$line" | awk '{print $3}')
        flags=$(printf '%s\n' "$line" | awk '{print $4}')
        secured=false
        case "$flags" in *WPA*|*WEP*|*RSN*) secured=true ;; esac
        printf '{"ssid":"%s","signal":%s,"secured":%s}\n' \
            "$(json_escape "$ssid")" "${signal:-0}" "$secured"
    done >"$tmp"
    first=1
    printf '['
    while IFS= read -r obj; do
        [ -n "$obj" ] || continue
        if [ "$first" -eq 1 ]; then
            first=0
        else
            printf ','
        fi
        printf '%s' "$obj"
    done <"$tmp"
    printf ']\n'
    rm -f "$tmp"
}

do_forget_wpa() {
    ssid=$1
    ensure_wpa || return 1
    list=$(wpa_cli -i "$IFACE" list_networks 2>/dev/null | tail -n +2 || true)
    printf '%s\n' "$list" | while IFS= read -r line; do
        [ -n "$line" ] || continue
        id=$(printf '%s\n' "$line" | cut -f1)
        net_ssid=$(printf '%s\n' "$line" | cut -f2)
        if [ "$net_ssid" = "$ssid" ]; then
            wpa_cli -i "$IFACE" remove_network "$id" >/dev/null || true
        fi
    done
    wpa_cli -i "$IFACE" save_config >/dev/null || true
    echo '{}'
}

do_connect_wpa() {
    ssid=$1
    psk=${2:-}
    # Hand the radio to wpa_supplicant. NM's brcmfmac path often associates
    # then never finishes the 4-way handshake ("association took too long").
    nm_release_wifi
    ip link set "$IFACE" up 2>/dev/null || true
    ensure_wpa || return 1
    disable_powersave
    do_forget_wpa "$ssid" >/dev/null 2>&1 || true
    id=$(wpa_cli -i "$IFACE" add_network | tr -d '[:space:]')
    case "$id" in ''|*[!0-9]*) log "add_network failed: $id"; return 1 ;; esac

    wpa_ok set_network "$id" ssid "\"$ssid\"" || return 1

    if [ -n "$psk" ]; then
        if command -v wpa_passphrase >/dev/null 2>&1; then
            hex=$(wpa_passphrase "$ssid" "$psk" 2>/dev/null \
                | awk -F= '/^[[:space:]]*psk=/ {print $2; exit}')
            if [ -z "$hex" ]; then
                log "invalid passphrase for '$ssid'"
                wpa_cli -i "$IFACE" remove_network "$id" >/dev/null 2>&1 || true
                return 1
            fi
            wpa_ok set_network "$id" psk "$hex" || return 1
        else
            wpa_ok set_network "$id" psk "\"$psk\"" || return 1
        fi
        wpa_ok set_network "$id" key_mgmt WPA-PSK || return 1
        wpa_ok set_network "$id" proto RSN || true
        wpa_ok set_network "$id" pairwise CCMP || true
    else
        wpa_ok set_network "$id" key_mgmt NONE || return 1
    fi

    wpa_ok enable_network "$id" || return 1
    wpa_ok select_network "$id" || return 1
    wpa_cli -i "$IFACE" save_config >/dev/null 2>&1 || true

    if ! wait_for_completed "$id"; then
        # One more DHCP probe — handshake may have finished without COMPLETED.
        dhcp_wifi || true
        if [ -z "$(iface_ip)" ]; then
            wpa_cli -i "$IFACE" disable_network "$id" >/dev/null 2>&1 || true
            return 1
        fi
    fi

    dhcp_wifi || true
    i=0
    while [ "$i" -lt 8 ]; do
        [ -n "$(iface_ip)" ] && break
        sleep 1
        i=$((i + 1))
    done
    if [ -z "$(iface_ip)" ]; then
        log "associated but got no IPv4 address"
        return 1
    fi

    echo '{}'
}

do_disconnect_wpa() {
    ensure_wpa || return 1
    wpa_cli -i "$IFACE" disconnect >/dev/null || true
    echo '{}'
}

# ---------- dispatch ----------

do_status() {
    case "$(wifi_backend)" in
        nm) do_status_nm ;;
        wpa) do_status_wpa ;;
        *)
            echo '{"supported":false,"enabled":false,"connected":false,"ssid":"","ip":"","signal":0}'
            ;;
    esac
}

do_radio() {
    case "$(wifi_backend)" in
        nm) do_radio_nm "$@" ;;
        wpa) do_radio_wpa "$@" ;;
        *) log "no wifi backend (need nmcli or wpa_cli)"; return 1 ;;
    esac
}

do_scan() {
    case "$(wifi_backend)" in
        nm) do_scan_nm ;;
        wpa) do_scan_wpa ;;
        *)
            echo '[]'
            return 1
            ;;
    esac
}

do_connect() {
    # NM join is preferred for persistence, but brcmfmac + NM commonly fails
    # the 4-way handshake. Fall back to wpa_supplicant takeover so the
    # console actually gets online.
    if have_nmcli; then
        if do_connect_nm "$@"; then
            return 0
        fi
        log "NM join failed; falling back to wpa_supplicant"
    fi
    if have_wpa_cli; then
        do_connect_wpa "$@"
        return $?
    fi
    log "no wifi backend (need nmcli or wpa_cli)"
    return 1
}

do_disconnect() {
    case "$(wifi_backend)" in
        nm) do_disconnect_nm ;;
        wpa) do_disconnect_wpa ;;
        *) log "no wifi backend (need nmcli or wpa_cli)"; return 1 ;;
    esac
}

do_forget() {
    case "$(wifi_backend)" in
        nm) do_forget_nm "$@" ;;
        wpa) do_forget_wpa "$@" ;;
        *) log "no wifi backend (need nmcli or wpa_cli)"; return 1 ;;
    esac
}

usage() {
    log "usage: $0 status|scan|connect <ssid> [psk]|disconnect|forget <ssid>|radio on|off"
    exit 2
}

[ $# -ge 1 ] || usage
verb=$1
shift

case "$verb" in
    status) do_status ;;
    scan) do_scan ;;
    connect)
        [ $# -ge 1 ] || usage
        do_connect "$@"
        ;;
    disconnect) do_disconnect ;;
    forget)
        [ $# -ge 1 ] || usage
        do_forget "$1"
        ;;
    radio)
        [ $# -ge 1 ] || usage
        do_radio "$1"
        ;;
    *) usage ;;
esac
