#!/bin/sh
# loopy-wifi-ctl — privileged WiFi helper the Flutter app drives.
#
# Verbs (stdout = compact JSON; detail on stderr):
#   status                 {supported,enabled,connected,ssid,ip,signal}
#   scan                   [{ssid,signal,secured}, ...]
#   connect <ssid> [psk]   {} on success (waits for association)
#   disconnect             {}
#   forget <ssid>          {}
#   radio on|off           {}  (iface up/down — Control Center tap toggle)
#
# Uses wpa_cli against wpa_supplicant; addressing comes from systemd-networkd
# DHCP on wlan* (see 25-wlan.network).
set -eu

IFACE="${LOOPY_WIFI_IFACE:-wlan0}"
CONF="${LOOPY_WPA_CONF:-/etc/wpa_supplicant/wpa_supplicant-${IFACE}.conf}"
CTRL_DIR="${LOOPY_WPA_CTRL:-/run/wpa_supplicant}"
# How long connect waits for wpa_state=COMPLETED (seconds).
CONNECT_TIMEOUT_SECS="${LOOPY_WIFI_CONNECT_TIMEOUT:-30}"

log() { echo "loopy-wifi-ctl: $*" >&2; }

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# Run a wpa_cli command; succeed only on an OK reply.
wpa_ok() {
    out=$(wpa_cli -i "$IFACE" "$@" 2>&1) || true
    case "$out" in
        OK*) return 0 ;;
        *)
            log "wpa_cli $* -> $out"
            return 1
            ;;
    esac
}

ensure_conf() {
    mkdir -p "$(dirname "$CONF")"
    # Yocto appliance has no Debian-style `netdev` group. GROUP=netdev makes
    # wpa_supplicant refuse to open the control socket ("Invalid group
    # 'netdev'") and WiFi scan/connect die. Root-only ctrl_interface is fine
    # here — helpers run as root via the Flutter Process boundary.
    if [ ! -f "$CONF" ]; then
        cat >"$CONF" <<EOF
ctrl_interface=DIR=${CTRL_DIR}
update_config=1
EOF
        return 0
    fi
    # Repair earlier helper revisions without wiping saved networks.
    if grep -q 'GROUP=netdev' "$CONF" 2>/dev/null \
        && ! grep -q '^netdev:' /etc/group 2>/dev/null; then
        sed -i 's/ GROUP=netdev//' "$CONF"
    fi
}

disable_powersave() {
    # brcmfmac power-save is a common cause of WPA auth timeouts on the Pi.
    command -v iw >/dev/null 2>&1 || return 0
    iw dev "$IFACE" set power_save off >/dev/null 2>&1 || true
}

ensure_wpa() {
    ensure_conf
    mkdir -p "$CTRL_DIR"
    if wpa_cli -i "$IFACE" ping >/dev/null 2>&1; then
        disable_powersave
        return 0
    fi
    if command -v systemctl >/dev/null 2>&1 \
        && systemctl start "wpa_supplicant@${IFACE}.service" 2>/dev/null; then
        sleep 0.5
    fi
    if ! wpa_cli -i "$IFACE" ping >/dev/null 2>&1; then
        if ! command -v wpa_supplicant >/dev/null 2>&1; then
            log "wpa_supplicant not installed"
            return 1
        fi
        wpa_supplicant -B -i "$IFACE" -c "$CONF" || true
        sleep 0.5
    fi
    disable_powersave
    wpa_cli -i "$IFACE" ping >/dev/null 2>&1
}

iface_ip() {
    ip -4 -o addr show dev "$IFACE" 2>/dev/null \
        | awk '{print $4}' | cut -d/ -f1 | head -n1
}

iface_enabled() {
    # Administratively UP (Control Center "WiFi on"), even without an AP.
    # Match IFF_UP inside the <flags> list — `[^,]UP` wrongly misses `,UP`
    # when other flags precede it (the usual case: NO-CARRIER,...,UP).
    ip -o link show "$IFACE" 2>/dev/null | grep -Eq '[,<]UP[,>]'
}

wpa_state() {
    wpa_cli -i "$IFACE" status 2>/dev/null | sed -n 's/^wpa_state=//p' | head -n1
}

# True when the selected network was temp-disabled after auth failures.
network_temp_disabled() {
    id=$1
    wpa_cli -i "$IFACE" list_networks 2>/dev/null \
        | awk -v id="$id" 'NR>1 && $1==id {print; exit}' \
        | grep -q 'TEMP-DISABLED'
}

# Wait until COMPLETED, TEMP-DISABLED (auth fail), or timeout.
wait_for_completed() {
    id=$1
    i=0
    while [ "$i" -lt "$CONNECT_TIMEOUT_SECS" ]; do
        state=$(wpa_state)
        if [ "$state" = "COMPLETED" ]; then
            return 0
        fi
        if network_temp_disabled "$id"; then
            log "authentication failed for network $id (wrong password?)"
            return 1
        fi
        sleep 1
        i=$((i + 1))
    done
    state=$(wpa_state)
    if [ "$state" = "COMPLETED" ]; then
        return 0
    fi
    log "timed out waiting for association (state=${state:-unknown})"
    return 1
}

do_status() {
    if ! command -v wpa_cli >/dev/null 2>&1; then
        echo '{"supported":false,"enabled":false,"connected":false,"ssid":"","ip":"","signal":0}'
        return 0
    fi
    # Do NOT ensure_wpa here — that would bring a user-disabled radio back up
    # on every Control Center poll. Report iface UP as "enabled".
    enabled=false
    iface_enabled && enabled=true
    if [ "$enabled" != true ]; then
        echo '{"supported":true,"enabled":false,"connected":false,"ssid":"","ip":"","signal":0}'
        return 0
    fi
    state=$(wpa_cli -i "$IFACE" status 2>/dev/null || true)
    if [ -z "$state" ]; then
        echo '{"supported":true,"enabled":true,"connected":false,"ssid":"","ip":"","signal":0}'
        return 0
    fi
    wpa_st=$(printf '%s\n' "$state" | sed -n 's/^wpa_state=//p' | head -n1)
    ssid=$(printf '%s\n' "$state" | sed -n 's/^ssid=//p' | head -n1)
    signal=$(printf '%s\n' "$state" | sed -n 's/^rssi=//p' | head -n1)
    if [ -z "$signal" ] || [ "$signal" = "0" ]; then
        # status often omits rssi; signal_poll is more reliable when associated.
        signal=$(wpa_cli -i "$IFACE" signal_poll 2>/dev/null \
            | sed -n 's/^RSSI=//p' | head -n1)
    fi
    [ -n "$signal" ] || signal=0
    ip=$(iface_ip)
    connected=false
    [ "$wpa_st" = "COMPLETED" ] && connected=true
    printf '{"supported":true,"enabled":true,"connected":%s,"ssid":"%s","ip":"%s","signal":%s}\n' \
        "$connected" "$(json_escape "$ssid")" "$(json_escape "${ip:-}")" "$signal"
}

do_radio() {
    onoff=$1
    case "$onoff" in on|off) ;; *) log "radio needs on|off"; return 2 ;; esac
    if [ "$onoff" = on ]; then
        ip link set "$IFACE" up 2>/dev/null || true
        ensure_wpa || return 1
        disable_powersave
    else
        wpa_cli -i "$IFACE" disconnect >/dev/null 2>&1 || true
        ip link set "$IFACE" down 2>/dev/null || true
    fi
    echo '{}'
}

do_scan() {
    ensure_wpa || {
        echo '[]'
        return 1
    }
    disable_powersave
    wpa_cli -i "$IFACE" scan >/dev/null 2>&1 || true
    # Fresh radio-on needs a beat longer for the first scan to populate.
    sleep 3
    results=$(wpa_cli -i "$IFACE" scan_results 2>/dev/null | tail -n +2 || true)
    if [ -z "$results" ]; then
        sleep 2
        results=$(wpa_cli -i "$IFACE" scan_results 2>/dev/null | tail -n +2 || true)
    fi
    tmp=$(mktemp)
    printf '%s\n' "$results" | while IFS= read -r line; do
        [ -n "$line" ] || continue
        ssid=$(printf '%s\n' "$line" | awk '{
            for (i=5; i<=NF; i++) printf "%s%s", (i>5?" ":""), $i
        }')
        [ -n "$ssid" ] || continue
        signal=$(printf '%s\n' "$line" | awk '{print $3}')
        flags=$(printf '%s\n' "$line" | awk '{print $4}')
        secured=false
        case "$flags" in *WPA*|*WEP*|*RSN*) secured=true ;; esac
        printf '{"ssid":"%s","signal":%s,"secured":%s}\n' \
            "$(json_escape "$ssid")" "${signal:-0}" "$secured"
    done >"$tmp"
    first=1
    printf '['
    while IFS= read -r obj; do
        [ -n "$obj" ] || continue
        if [ "$first" -eq 1 ]; then
            first=0
        else
            printf ','
        fi
        printf '%s' "$obj"
    done <"$tmp"
    printf ']\n'
    rm -f "$tmp"
}

do_connect() {
    ssid=$1
    psk=${2:-}
    ensure_wpa || return 1
    disable_powersave
    do_forget "$ssid" >/dev/null 2>&1 || true
    id=$(wpa_cli -i "$IFACE" add_network | tr -d '[:space:]')
    case "$id" in ''|*[!0-9]*) log "add_network failed: $id"; return 1 ;; esac

    wpa_ok set_network "$id" ssid "\"$ssid\"" || return 1

    if [ -n "$psk" ]; then
        # Prefer a hex PSK from wpa_passphrase — avoids wpa_cli quoting edge
        # cases on ASCII passphrases and validates length early.
        if command -v wpa_passphrase >/dev/null 2>&1; then
            hex=$(wpa_passphrase "$ssid" "$psk" 2>/dev/null \
                | awk -F= '/^[[:space:]]*psk=/ {print $2; exit}')
            if [ -z "$hex" ]; then
                log "invalid passphrase for '$ssid'"
                wpa_cli -i "$IFACE" remove_network "$id" >/dev/null 2>&1 || true
                return 1
            fi
            wpa_ok set_network "$id" psk "$hex" || return 1
        else
            wpa_ok set_network "$id" psk "\"$psk\"" || return 1
        fi
        wpa_ok set_network "$id" key_mgmt WPA-PSK || return 1
        wpa_ok set_network "$id" proto RSN || true
        wpa_ok set_network "$id" pairwise CCMP || true
    else
        wpa_ok set_network "$id" key_mgmt NONE || return 1
    fi

    wpa_ok enable_network "$id" || return 1
    wpa_ok select_network "$id" || return 1
    wpa_cli -i "$IFACE" save_config >/dev/null 2>&1 || true

    if ! wait_for_completed "$id"; then
        wpa_cli -i "$IFACE" disable_network "$id" >/dev/null 2>&1 || true
        return 1
    fi

    # Best-effort DHCP settle so status can include an address.
    i=0
    while [ "$i" -lt 8 ]; do
        [ -n "$(iface_ip)" ] && break
        sleep 1
        i=$((i + 1))
    done

    echo '{}'
}

do_disconnect() {
    ensure_wpa || return 1
    wpa_cli -i "$IFACE" disconnect >/dev/null || true
    echo '{}'
}

do_forget() {
    ssid=$1
    ensure_wpa || return 1
    # list_networks is tab-separated: id, ssid, bssid, flags — use cut so
    # SSIDs with spaces survive (awk \$2 would truncate them).
    list=$(wpa_cli -i "$IFACE" list_networks 2>/dev/null | tail -n +2 || true)
    printf '%s\n' "$list" | while IFS= read -r line; do
        [ -n "$line" ] || continue
        id=$(printf '%s\n' "$line" | cut -f1)
        net_ssid=$(printf '%s\n' "$line" | cut -f2)
        if [ "$net_ssid" = "$ssid" ]; then
            wpa_cli -i "$IFACE" remove_network "$id" >/dev/null || true
        fi
    done
    wpa_cli -i "$IFACE" save_config >/dev/null || true
    echo '{}'
}

usage() {
    log "usage: $0 status|scan|connect <ssid> [psk]|disconnect|forget <ssid>|radio on|off"
    exit 2
}

[ $# -ge 1 ] || usage
verb=$1
shift

case "$verb" in
    status) do_status ;;
    scan) do_scan ;;
    connect)
        [ $# -ge 1 ] || usage
        do_connect "$@"
        ;;
    disconnect) do_disconnect ;;
    forget)
        [ $# -ge 1 ] || usage
        do_forget "$1"
        ;;
    radio)
        [ $# -ge 1 ] || usage
        do_radio "$1"
        ;;
    *) usage ;;
esac
