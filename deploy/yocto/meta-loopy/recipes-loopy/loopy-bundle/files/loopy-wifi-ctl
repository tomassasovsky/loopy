#!/bin/sh
# loopy-wifi-ctl — privileged WiFi helper the Flutter app drives.
#
# Verbs (stdout = compact JSON; detail on stderr):
#   status                 {supported,enabled,connected,ssid,ip,signal}
#   scan                   [{ssid,signal,secured}, ...]
#   connect <ssid> [psk]   {} on success (waits for activation)
#   disconnect             {}
#   forget <ssid>          {}
#   radio on|off           {}  (WiFi radio — Control Center tap toggle)
#
# NetworkManager / nmcli owns association + DHCP (and wpa_supplicant as its
# wifi backend). systemd-networkd is masked on the appliance image.
set -eu

IFACE="${LOOPY_WIFI_IFACE:-wlan0}"
CONNECT_WAIT_SECS="${LOOPY_WIFI_CONNECT_TIMEOUT:-45}"

log() { echo "loopy-wifi-ctl: $*" >&2; }

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

have_nmcli() {
    command -v nmcli >/dev/null 2>&1
}

# Map nmcli activation failures to a stable stderr token the Flutter UI matches.
map_connect_error() {
    err=$1
    lower=$(printf '%s' "$err" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
        *'secrets were required'*|*'no secrets'*|*'property is missing'*|*wrong*password*)
            log "authentication failed (wrong password?)"
            ;;
        *'802.1x supplicant took too long'*|*timeout*|*took too long*)
            log "timed out waiting for association"
            ;;
        *)
            log "connection failed: $err"
            ;;
    esac
}

do_status() {
    if ! have_nmcli; then
        echo '{"supported":false,"enabled":false,"connected":false,"ssid":"","ip":"","signal":0}'
        return 0
    fi

    wifi_radio=$(nmcli -t -f WIFI radio 2>/dev/null || echo disabled)
    enabled=false
    case "$wifi_radio" in enabled|on) enabled=true ;; esac

    if [ "$enabled" != true ]; then
        echo '{"supported":true,"enabled":false,"connected":false,"ssid":"","ip":"","signal":0}'
        return 0
    fi

    # GENERAL.STATE looks like "100 (connected)" when associated.
    state=$(nmcli -t -f GENERAL.STATE device show "$IFACE" 2>/dev/null \
        | sed -n 's/^GENERAL.STATE://p' | head -n1)
    connected=false
    case "$state" in 100\ *|*\(connected\)*) connected=true ;; esac

    ssid=$(nmcli -t -f GENERAL.CONNECTION device show "$IFACE" 2>/dev/null \
        | sed -n 's/^GENERAL.CONNECTION://p' | head -n1)
    case "$ssid" in ''|--*) ssid= ;; esac

    ip=$(nmcli -t -f IP4.ADDRESS device show "$IFACE" 2>/dev/null \
        | sed -n 's/^IP4.ADDRESS\[[0-9]*\]://p' | head -n1 | cut -d/ -f1)

    signal=0
    if [ "$connected" = true ] && [ -n "$ssid" ]; then
        signal=$(nmcli -t -f IN-USE,SSID,SIGNAL device wifi list ifname "$IFACE" 2>/dev/null \
            | awk -F: -v s="$ssid" '$1=="*" && $2==s {print $3; exit}')
        [ -n "$signal" ] || signal=0
    fi

    printf '{"supported":true,"enabled":true,"connected":%s,"ssid":"%s","ip":"%s","signal":%s}\n' \
        "$connected" "$(json_escape "${ssid:-}")" "$(json_escape "${ip:-}")" "$signal"
}

do_radio() {
    onoff=$1
    case "$onoff" in on|off) ;; *) log "radio needs on|off"; return 2 ;; esac
    have_nmcli || {
        log "nmcli not installed"
        return 1
    }
    nmcli radio wifi "$onoff" >/dev/null
    echo '{}'
}

do_scan() {
    have_nmcli || {
        echo '[]'
        return 1
    }
    nmcli radio wifi on >/dev/null 2>&1 || true
    nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1 || true
    sleep 2

    raw=$(mktemp)
    ranked=$(mktemp)
    nmcli -t -f SSID,SIGNAL,SECURITY device wifi list ifname "$IFACE" 2>/dev/null >"$raw" || true

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        security=${line##*:}
        rest=${line%:*}
        signal=${rest##*:}
        ssid=${rest%:*}
        [ -n "$ssid" ] || continue
        case "$ssid" in --*) continue ;; esac
        secured=true
        case "$security" in ''|--*) secured=false ;; esac
        # Escape tabs in SSID for the staging file (rare).
        ssid_safe=$(printf '%s' "$ssid" | tr '\t' ' ')
        printf '%s\t%s\t%s\n' "$ssid_safe" "${signal:-0}" "$secured"
    done <"$raw" | awk -F'\t' '
        {
            ssid=$1; sig=$2+0; sec=$3
            if (!(ssid in best) || sig > best[ssid]) {
                best[ssid]=sig
                secured[ssid]=sec
            }
        }
        END {
            for (s in best) printf "%s\t%d\t%s\n", s, best[s], secured[s]
        }
    ' | sort -t"$(printf '\t')" -k2,2nr >"$ranked"

    first=1
    printf '['
    while IFS="$(printf '\t')" read -r ssid signal secured; do
        [ -n "$ssid" ] || continue
        if [ "$first" -eq 1 ]; then
            first=0
        else
            printf ','
        fi
        printf '{"ssid":"%s","signal":%s,"secured":%s}' \
            "$(json_escape "$ssid")" "$signal" "$secured"
    done <"$ranked"
    printf ']\n'
    rm -f "$raw" "$ranked"
}

do_forget() {
    ssid=$1
    have_nmcli || return 1
    nmcli -t -f UUID,NAME,TYPE connection show 2>/dev/null \
        | awk -F: '$3 ~ /wireless|wifi/ {print $1"\t"$2}' \
        | while IFS="$(printf '\t')" read -r uuid name; do
            [ -n "$uuid" ] || continue
            profile_ssid=$(nmcli -t -f 802-11-wireless.ssid connection show "$uuid" 2>/dev/null \
                | sed -n 's/^802-11-wireless.ssid://p')
            if [ "$name" = "$ssid" ] || [ "$profile_ssid" = "$ssid" ]; then
                nmcli connection delete uuid "$uuid" >/dev/null 2>&1 || true
            fi
        done
    echo '{}'
}

do_connect() {
    ssid=$1
    psk=${2:-}
    have_nmcli || {
        log "nmcli not installed"
        return 1
    }
    nmcli radio wifi on >/dev/null 2>&1 || true
    # Drop stale profiles so a prior wrong PSK cannot poison activation
    # ("Secrets were required, but not provided").
    do_forget "$ssid" >/dev/null 2>&1 || true

    errf=$(mktemp)
    set +e
    if [ -n "$psk" ]; then
        nmcli --wait "$CONNECT_WAIT_SECS" device wifi connect "$ssid" \
            password "$psk" ifname "$IFACE" >"$errf" 2>&1
    else
        nmcli --wait "$CONNECT_WAIT_SECS" device wifi connect "$ssid" \
            ifname "$IFACE" >"$errf" 2>&1
    fi
    rc=$?
    set -e
    if [ "$rc" -ne 0 ]; then
        map_connect_error "$(cat "$errf")"
        rm -f "$errf"
        return 1
    fi
    rm -f "$errf"
    echo '{}'
}

do_disconnect() {
    have_nmcli || return 1
    nmcli device disconnect "$IFACE" >/dev/null 2>&1 || true
    echo '{}'
}

usage() {
    log "usage: $0 status|scan|connect <ssid> [psk]|disconnect|forget <ssid>|radio on|off"
    exit 2
}

[ $# -ge 1 ] || usage
verb=$1
shift

case "$verb" in
    status) do_status ;;
    scan) do_scan ;;
    connect)
        [ $# -ge 1 ] || usage
        do_connect "$@"
        ;;
    disconnect) do_disconnect ;;
    forget)
        [ $# -ge 1 ] || usage
        do_forget "$1"
        ;;
    radio)
        [ $# -ge 1 ] || usage
        do_radio "$1"
        ;;
    *) usage ;;
esac
